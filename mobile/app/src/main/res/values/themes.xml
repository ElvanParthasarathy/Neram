<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main app theme (Light) - extends OneUITheme for SESL ToolbarLayout compatibility -->
    <style name="Theme.Neram" parent="OneUITheme">
        <item name="colorPrimary">#0D84FF</item>
        <item name="colorPrimaryDark">#0066CC</item>
        <item name="colorAccent">#0D84FF</item>
        <item name="colorSecondary">#0D84FF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#FAFAFA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="android:textColorHighlight">#330D84FF</item>
        <item name="android:textColorLink">#0D84FF</item>
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#757575</item>
    </style>
    
    <!-- Splash theme for backwards compatibility (pre-Android 12) -->
    <style name="Theme.Neram.Splash" parent="Theme.Neram">
        <item name="colorPrimary">#0D84FF</item>
        <item name="colorAccent">#0D84FF</item>
    </style>

    <style name="OneUI.Neram.DatePickerDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">#0D84FF</item>
        <item name="colorAccent">#0D84FF</item>
        <item name="android:textColorHighlight">#330D84FF</item>
        <item name="android:textColorLink">#0D84FF</item>
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#757575</item>
    </style>
</resources>