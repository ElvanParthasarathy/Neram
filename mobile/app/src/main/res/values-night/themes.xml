<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme - extends OneUITheme (night) for SESL ToolbarLayout compatibility -->
    <style name="Theme.Neram" parent="OneUITheme">
        <item name="colorPrimary">#0D84FF</item>
        <item name="colorPrimaryDark">#0066CC</item>
        <item name="colorAccent">#0D84FF</item>
        <item name="colorSecondary">#0D84FF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0A0A0A</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
    
    <!-- Splash theme for backwards compatibility (pre-Android 12) -->
    <style name="Theme.Neram.Splash" parent="Theme.Neram">
        <item name="colorPrimary">#0D84FF</item>
        <item name="colorAccent">#0D84FF</item>
    </style>
</resources>
